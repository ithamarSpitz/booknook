{
  "name": "booknook",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "supabase:start": "supabase start",
    "functions:serve": "node scripts/serve-functions.mjs",
    "web:serve": "python -m http.server 4175 --bind 127.0.0.1 --directory public",
    "check:functions": "deno check supabase/functions",
    "test:functions": "deno test --permit-no-files --allow-env --allow-read tests/functions",
    "test:web": "node --test \"tests/web/**/*.test.mjs\"",
    "test:db": "supabase db reset && supabase test db",
    "check:contract": "node scripts/check-contract.mjs",
    "check:harness": "harness validate",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:resolution": "deno run --allow-net --allow-env --allow-read scripts/verify-resolution.ts",
    "verify:english": "deno run --allow-net --allow-env --allow-read scripts/verify-english.ts",
    "verify:localization": "deno run --allow-net --allow-env --allow-read scripts/verify-localization.ts"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^2.54.11"
  }
}
